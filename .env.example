OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=xhigh
OPENAI_SERVICE_TIER=priority

DEEPGRAM_API_KEY=your-deepgram-key

# Used only by the Netlify function to verify Stripe events before sending
# pseudonymous conversion events to PostHog. Never expose this in the browser.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

GITHUB_TOKEN=github_pat_or_classic_token
GITHUB_OWNER=your-github-username

ARDUINO_CLI_PATH=/Applications/Arduino IDE.app/Contents/Resources/app/lib/backend/resources/arduino-cli
ARDUINO_FQBN=esp32:esp32:esp32

PORT=8787
